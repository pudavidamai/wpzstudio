# Gemfile / Gemfile.lock ARE committed: they pin the same `github-pages`
# version GitHub Pages builds with, so a local build matches production.
node_modules/
# Top-level package.json is ignored (was Jekyll scaffold artifact),
# but tools/package.json is committed (needed for Actions).
/package.json
/package-lock.json

# Local sync diff-report artifact (tools/scripts/sync-report.mjs --json)
tools/wpz-sync-diff.json

# Local publisher-enumeration cache (tools/scripts/fetch-publisher-markets.mjs).
# Regenerate with: npm --dir tools run publisher:fetch
tools/.publisher-markets.json

